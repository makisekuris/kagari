# Kagari 启动时读取当前工作目录的 .env，无需手动 source。 / Kagari loads .env from the current working directory; no manual source is needed.
# 配置优先级：系统环境变量 > .env > config.yaml > 默认值。 / Precedence: process environment > .env > config.yaml > defaults.
# 复制为 .env 后填写；.env 已被 Git 忽略，切勿把真实凭证放进此示例。 / Copy this to .env and fill it in; .env is Git-ignored, so never put real credentials in this example.

# Responses 兼容 endpoint 的 base URL，通常包含 /v1；不要加 /responses。 / Base URL for a Responses-compatible endpoint, usually including /v1; do not append /responses.
KAGARI_MODEL_BASE_URL=
KAGARI_MODEL_NAME=
KAGARI_MODEL_API_KEY=''

# Telegram BotFather 提供的 token；仅运行 Telegram 服务时需要。 / Token from Telegram's BotFather; only needed when running the Telegram service.
KAGARI_TELEGRAM_TOKEN=''

# 也可在 config.yaml 配置；列表使用英文逗号分隔，例如 123456,789012。 / Can also be set in config.yaml; separate IDs with commas, e.g. 123456,789012.
# KAGARI_TELEGRAM_ALLOWED_USER_IDS=123456
# 0 回复提交所在私聊；频道通常使用负的 chat ID，并需授予 bot 发言权限。 / 0 replies in the submitting private chat; channels usually have a negative chat ID and require posting permission for the bot.
# KAGARI_TELEGRAM_TARGET_CHAT_ID=0
# 多目标优先于单目标；包含自己的私聊 ID 和频道 ID。 / Multiple targets take precedence over the single target; include your private chat ID and channel ID.
# KAGARI_TELEGRAM_TARGET_CHAT_IDS=123456,-1001234567890

# 其余配置通常保留在 config.yaml；以下示例可按需要取消注释。 / Keep other settings in config.yaml; uncomment these examples as needed.
# KAGARI_STORAGE_PATH=data/kagari.db
# KAGARI_PROFILE_PATH=profile.md
# KAGARI_LOG_LEVEL=info
# false 使用普通 Responses 请求；true 使用 SSE，并在 info 日志逐段记录模型输出。 / false uses regular Responses requests; true uses SSE and logs model output chunks at info level.
# KAGARI_AGENT_STREAMING=false
# 包含首次尝试：6 表示首次加最多 5 次重试；中间失败不向 Bot 推送。 / Includes the first attempt: 6 means one initial attempt plus up to 5 retries; intermediate failures are not sent to the bot.
# KAGARI_MAX_ATTEMPTS=6
# 仅填写部署环境确实需要放行的网段，例如 TUN 配置中的 Fake-IP 地址池。 / Only allow ranges required by your deployment, such as a TUN Fake-IP pool.
# KAGARI_READER_ALLOWED_NON_PUBLIC_CIDRS=198.18.0.0/16

# 网页读取失败后改用浏览器的功能尚未实现；当前可保存配置，但 enabled=true 会拒绝启动。 / Browser fallback is not implemented; configuration can be saved, but enabled=true is rejected at startup.
# 引擎可选 chromium/firefox/webkit；默认 Chromium 不要求系统安装 Google Chrome。 / Engines: chromium/firefox/webkit; the default Chromium does not require Google Chrome to be installed system-wide.
# KAGARI_READER_BROWSER_FALLBACK_ENABLED=false
# KAGARI_READER_BROWSER_FALLBACK_ENGINE=chromium
# KAGARI_READER_BROWSER_FALLBACK_MODE=launch
# KAGARI_READER_BROWSER_FALLBACK_EXECUTABLE_PATH=''
# KAGARI_READER_BROWSER_FALLBACK_HEADLESS=true
# connect 使用服务提供的 Playwright ws/wss endpoint；cdp 仅 Chromium，支持 http/https/ws/wss。 / connect uses a Playwright ws/wss endpoint; cdp is Chromium-only and accepts http/https/ws/wss.
# 远程模式须清空 executable_path；endpoint 含 token 时放在部署环境或私有 .env。 / Clear executable_path for remote modes; keep endpoints containing tokens in the deployment environment or private .env.
# KAGARI_READER_BROWSER_FALLBACK_ENDPOINT=''

# KAGARI_WEEKLY_ENABLED=false
# KAGARI_WEEKLY_TIMEZONE=Asia/Shanghai
# KAGARI_WEEKLY_WEEKDAY=1
# KAGARI_WEEKLY_TIME=09:00
# KAGARI_WEEKLY_MAX_INPUT_CHARS=120000
