# Kagari 启动时读取当前工作目录的 .env，无需手动 source。
# 配置优先级：系统环境变量 > .env > config.yaml > 默认值。
# 复制为 .env 后填写；.env 已被 Git 忽略，切勿把真实凭证放进此示例。

# Responses 兼容 endpoint 的 base URL，通常包含 /v1；不要加 /responses。
KAGARI_MODEL_BASE_URL=
KAGARI_MODEL_NAME=
KAGARI_MODEL_API_KEY=''

# Telegram BotFather 提供的 token；仅运行 Telegram 服务时需要。
KAGARI_TELEGRAM_TOKEN=''

# 也可在 config.yaml 配置；列表使用英文逗号分隔，例如 123456,789012。
# KAGARI_TELEGRAM_ALLOWED_USER_IDS=123456
# 0 回复提交所在私聊；频道通常使用负的 chat ID，并需授予 bot 发言权限。
# KAGARI_TELEGRAM_TARGET_CHAT_ID=0

# 其余配置通常保留在 config.yaml；以下示例可按需要取消注释。
# KAGARI_STORAGE_PATH=data/kagari.db
# KAGARI_PROFILE_PATH=profile.md
# KAGARI_LOG_LEVEL=info

# 浏览器回落尚未实现，当前只能预配置，enabled=true 会明确拒绝启动。
# 引擎可选 chromium/firefox/webkit；默认 Chromium 不要求系统安装 Google Chrome。
# KAGARI_READER_BROWSER_FALLBACK_ENABLED=false
# KAGARI_READER_BROWSER_FALLBACK_ENGINE=chromium
# KAGARI_READER_BROWSER_FALLBACK_MODE=launch
# KAGARI_READER_BROWSER_FALLBACK_EXECUTABLE_PATH=''
# KAGARI_READER_BROWSER_FALLBACK_HEADLESS=true
# connect 使用服务提供的 Playwright ws/wss endpoint；cdp 仅 Chromium，支持 http/https/ws/wss。
# 远程模式须清空 executable_path；endpoint 含 token 时放在部署环境或私有 .env。
# KAGARI_READER_BROWSER_FALLBACK_ENDPOINT=''

# KAGARI_WEEKLY_ENABLED=false
# KAGARI_WEEKLY_TIMEZONE=Asia/Shanghai
# KAGARI_WEEKLY_WEEKDAY=1
# KAGARI_WEEKLY_TIME=09:00
