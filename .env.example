# Kagari 启动时读取当前工作目录的 .env，无需手动 source。 / Kagari loads .env from the current working directory; no manual source is needed.
# 配置优先级：系统环境变量 > .env > config.yaml > 默认值。 / Precedence: process environment > .env > config.yaml > defaults.
# 复制为 .env 后填写；.env 已被 Git 忽略，切勿把真实凭证放进此示例。 / Copy this to .env and fill it in; .env is Git-ignored, so never put real credentials in this example.

# Responses 兼容 endpoint 的 base URL，通常包含 /v1；不要加 /responses。 / Base URL for a Responses-compatible endpoint, usually including /v1; do not append /responses.
KAGARI_MODEL_BASE_URL=
KAGARI_MODEL_NAME=
KAGARI_MODEL_API_KEY=''

# Telegram BotFather 提供的 token；仅运行 Telegram 服务时需要。 / Token from Telegram's BotFather; only needed when running the Telegram service.
KAGARI_TELEGRAM_TOKEN=''

# 也可在 config.yaml 配置；personal 服务只能填写一个正数 user ID。 / Can also be set in config.yaml; personal mode requires exactly one positive user ID.
# KAGARI_TELEGRAM_ALLOWED_USER_IDS=123456
# personal 服务必须留空；旧版 digest CLI 可另行指定投递目标。 / Must stay empty for personal mode; legacy digest CLI can specify its own targets.
# KAGARI_TELEGRAM_TARGET_CHAT_IDS=

# 其余配置通常保留在 config.yaml；以下示例可按需要取消注释。 / Keep other settings in config.yaml; uncomment these examples as needed.
# KAGARI_STORAGE_PATH=data/kagari.db
# KAGARI_PROFILE_PATH=profile.md
# V2 log_level controls terminal output; files retain info+ and legacy CLI behavior is unchanged. / V2 的 log_level 控制终端输出；文件保留 info+ 级别，旧 CLI 行为不变。
# KAGARI_LOG_LEVEL=info
# File logs include full application payloads after known credentials are redacted. Empty directory uses kagari.logs beside storage.path; files are removed at the size cap or age limit. / 文件日志记录完整应用 payload 并脱敏已知凭证；目录为空时使用 storage.path 同级的 kagari.logs，达到总大小上限或保留期限后删除。
# KAGARI_LOGGING_DIRECTORY=
# KAGARI_LOGGING_ROTATE_MIB=50
# KAGARI_LOGGING_MAX_TOTAL_MIB=1024
# KAGARI_LOGGING_RETENTION_DAYS=7
# 后台 Task 并发与每 Task 累计执行预算；等待时间不计。 / Background Task concurrency and cumulative execution budget per Task; waiting is excluded.
# KAGARI_PERSONAL_TASK_CONCURRENCY=4
# KAGARI_PERSONAL_TASK_BUDGET=30m
# false 使用普通 Responses 请求；true 对阅读/周报使用 SSE。 / false uses regular Responses requests; true enables SSE for reading and digests.
# KAGARI_AGENT_STREAMING=false
# 旧版归档 CLI 的尝试上限，包含首次尝试；personal 投递固定最多 3 次。 / Legacy archive attempt cap, including the first; personal deliveries use at most 3 total attempts.
# KAGARI_MAX_ATTEMPTS=6
# 仅填写部署环境确实需要放行的网段，例如 TUN 配置中的 Fake-IP 地址池。 / Only allow ranges required by your deployment, such as a TUN Fake-IP pool.
# KAGARI_READER_ALLOWED_NON_PUBLIC_CIDRS=198.18.0.0/16

# 使用 Playwright MCP 读取 JavaScript 页面，模型可选择 browse_url。 / Enable browse_url for JavaScript-rendered pages.
# KAGARI_BROWSER_ENABLED=false
# KAGARI_BROWSER_COMMAND=npx
# 浏览器启动参数写在 config.yaml 的 browser.args。 / Keep browser.args in config.yaml.

# KAGARI_WEEKLY_ENABLED=false
# KAGARI_WEEKLY_TIMEZONE=Asia/Shanghai
# KAGARI_WEEKLY_WEEKDAY=1
# KAGARI_WEEKLY_TIME=09:00
# KAGARI_WEEKLY_MAX_INPUT_CHARS=120000
